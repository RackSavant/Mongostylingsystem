# MongoDB Atlas — use a least-privilege user scoped to readWrite on the app DB.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority

# App database (default "needitnow")
MONGODB_DB=needitnow

# Isolated DB used by `RUN_DB_TESTS=1 bun test` (default "needitnow_test")
MONGODB_TEST_DB=needitnow_test

# API bearer token required by the HTTP API (>= 24 chars). Generate: openssl rand -hex 32
API_AUTH_TOKEN=
